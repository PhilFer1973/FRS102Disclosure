# Anthropic API (Sonnet for judgment/challenge, Haiku for classification/facts)
ANTHROPIC_API_KEY=

# Supabase (Postgres + pgvector)
SUPABASE_URL=
# SECRET key (sb_secret_...), not the publishable key — for REST/data access.
SUPABASE_SERVICE_KEY=
# Postgres connection string (Project Settings -> Database -> Connection string
# -> URI). Required to apply migrations and bulk-load the corpus + embeddings;
# the REST keys above cannot run DDL. Also used by the LangGraph checkpointer.
SUPABASE_DB_URL=

# Voyage AI (paragraph embeddings; voyage-3, 1024-dim)
VOYAGE_API_KEY=

# Azure — Document Intelligence (PDF extraction)
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# Azure — Blob Storage (FS models, uploaded files; UK South)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=

# Azure — Key Vault (production secret resolution; unused in local dev)
AZURE_KEY_VAULT_URL=
